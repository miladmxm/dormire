{
  "name": "dormire",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT-3000}",
    "build": "next build",
    "start": "next start -p ${PORT-3000}",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "type-check": "tsc --noEmit",
    "test:instant": "node --env-file=.env ./node_modules/@playwright/test/cli.js test e2e/instant-profile.spec.ts",
    "next:route-type": "next typegen",
    "prepare": "husky",
    "init-s3": "npx tsx --env-file=./.env ./src/scripts/init-s3.ts",
    "db:auth:generate": "npx @better-auth/cli generate",
    "db:seed": "npx tsx --env-file=./.env ./src/db/drizzle/seed.ts",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio --port 3001 --verbose"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ]
  },
  "dependencies": {
